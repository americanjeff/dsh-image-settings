{
  "name": "dsh-image-settings",
  "version": "0.1.0",
  "license": "MIT",
  "description": "User-tunable inline image display for dsh web sessions: a larger, auto-unrolling read_image tool view behind an image-settings section.",
  "author": "American Jeff <jeff@americanjeff.com>",
  "homepage": "https://github.com/americanjeff/dsh-image-settings",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/americanjeff/dsh-image-settings.git"
  },
  "bugs": {
    "url": "https://github.com/americanjeff/dsh-image-settings/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "images",
    "read_image",
    "tool-view",
    "settings"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/dsh/index.js",
  "types": "./dist/dsh/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dsh/index.d.ts",
      "default": "./dist/dsh/index.js"
    },
    "./client": "./dist/dsh/client.js",
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "dsh.cordis.yml",
    "assets/icons",
    "e2e-card-clean-dark.png"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.client.json && tsdown",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh.cordis.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "external": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": "next",
    "@deepseek-ai/dsh-client-store": "next",
    "@deepseek-ai/dsh-client-ui-renderer": "next",
    "@deepseek-ai/dsh-client-ui-settings": "next",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "next",
    "@deepseek-ai/dsh-client-ui-slots": "next",
    "@deepseek-ai/dsh-client-ui-tool": "next",
    "@deepseek-ai/dsh-settings": "next",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
